# Copy this file to .env and fill in real values for local development.
# Keep this file in git; do not put real secrets here.

# ==================== Server ====================
HOST_PORT=8125

# ==================== 登录系统 (Session 签名密钥) ====================
# 简易本地账号密码登录: 签发/校验 httpOnly cookie 的 HMAC 密钥, 必填, 建议随机长串
# 注意: 前端进程只读 frontend/.env.local, 需同步一份 AUTH_SECRET 到那里
AUTH_SECRET=<random-long-string>

# ==================== 后端 langgraph-api 地址 ====================
# 供代理/工具链确认后端位置 (前端直连配置在 frontend/.env.local 的 LANGGRAPH_API_URL)
LANGGRAPH_API_URL=http://localhost:2024

# ==================== SQLite Checkpointer (本地文件) ====================
# 单文件数据库,相对项目根,父目录会自动创建
SQLITE_PATH=db/checkpoints.db

# ==================== MCP Servers (凭据必需)====================
# 主业务数据源(MCP). 走内网地址, 如不可达请改成本地或自建服务
MCP_SERVER_URL=http://localhost:8090/product/ipp/api/mcp

# ==================== LangSmith 追踪 ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=app-final-test
LANGCHAIN_API_KEY=<langsmith-api-key>

# ==================== Langfuse 本地追踪 ====================
# run-local.sh 会启动本地 Langfuse v4 服务；SDK 从六个图的入口采集 LangGraph/LangChain trace。
# 公钥/私钥应与 .env.langfuse 中 LANGFUSE_INIT_PROJECT_* 对应。
# BASE_URL 走宿主机桥地址端口映射（langfuse-web 的 3001），避免跨容器服务名 DNS 不可靠。
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://192.168.64.1:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ==================== SiliconFlow (公网 Embedding)====================
SILICONFLOW_API_KEY=<siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ==================== 主 LLM (本机 workbuddy2api 网关)====================
# OpenAI 兼容 /v1/chat/completions. hy3 为推理模型, max_tokens 需包含思考预算.
# 192.168.64.1 = Apple Container 网桥上的宿主机地址; 网关需监听 0.0.0.0:8787
# (宿主机本机调试也可用 http://127.0.0.1:8787/v1).
MAIN_LLM_API_KEY=<main-llm-api-key>
MAIN_LLM_BASE_URL=http://192.168.64.1:8787/v1
MAIN_LLM_MODEL=hy3

# ==================== Serper (联网搜索)====================
SERPER_API_KEY=<serper-api-key>

# ==================== DuckDuckGo (备用)====================
DDGS_PROXY=
DDGS_REGION=cn-zh
DDGS_TIMEOUT=15
DDGS_BACKEND=bing,yandex

# ==================== 模型上下文与工具治理 ====================
# 主模型官方上下文窗口 (Tokens, HY3 默认为 192K)
MODEL_MAX_CONTEXT_TOKENS=192000
# 用户单次输入最大字符数限制
MAX_INPUT_CHARS=8000
# 单次工具输出触发 Subagent 总结与专属落库的字符阈值
TOOL_OUTPUT_SUMMARY_THRESHOLD_CHARS=20000
# 多轮对话发送给模型的安全上下文 Token 预算
MODEL_CONTEXT_BUDGET_TOKENS=120000
# Subagent 总结提炼使用的独立模型 (留空则复用 MAIN_LLM_MODEL)
SUMMARY_LLM=
# 多轮长会话触发大模型滚雪球摘要压缩的 Token 阈值
CONVERSATION_SUMMARY_THRESHOLD_TOKENS=30000
# 会话摘要时保留最近不被压缩的活跃轮次数量
CONVERSATION_SUMMARY_KEEP_TURNS=3

