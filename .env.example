# Copy this file to .env and fill in real values for local development.
# Keep this file in git; do not put real secrets here.

# ==================== Container ====================
CONTAINER_NAME=app_final_test
HOST_PORT=2024

# ==================== Ollama ====================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL1=bge-m3:latest
OLLAMA_EMBEDDING_MODEL2=nomic-embed-text:latest

# ==================== PostgreSQL ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<postgres-password>
POSTGRES_DB=ipp_air
DATABASE_URI=postgresql://postgres:<postgres-password>@localhost:5432/ipp_air

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URI=redis://localhost:6379/0

# ==================== Milvus ====================
MILVUS_URI=http://localhost:19530
MILVUS_DB_NAME=ipp_air_general

# ==================== MCP Servers ====================
MCP_SERVER_URL=http://localhost:8090/product/ipp/api/mcp
MCP_SERVER_URL2=http://localhost:8090/product/datacenter/api/mcp

# ==================== LangSmith ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=app-final-test
LANGCHAIN_API_KEY=<langsmith-api-key>

# ==================== SiliconFlow ====================
SILICONFLOW_API_KEY=<siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ==================== OpenCode Go DeepSeek V4 Flash ====================
OPENCODE_GO_DEEPSEEK_V4_FLASH_API_KEY=<opencode-go-deepseek-v4-flash-api-key>
OPENCODE_GO_DEEPSEEK_V4_FLASH_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash

# ==================== Serper ====================
SERPER_API_KEY=<serper-api-key>

# ==================== Text2SQL MySQL ====================
TEXT2SQL_MYSQL_HOST=localhost
TEXT2SQL_MYSQL_DB=yutu_datacenter
TEXT2SQL_MYSQL_USER=datacenter
TEXT2SQL_MYSQL_PASSWORD=<text2sql-mysql-password>
TEXT2SQL_MYSQL_PORT=9030

# ==================== Metadata API ====================
METADATA_API_URL=http://localhost:8090/product/datacenter/api/v5/ipp-chat/sql/correction

# ==================== DuckDuckGo ====================
DDGS_PROXY=
DDGS_REGION=cn-zh
DDGS_TIMEOUT=15
DDGS_BACKEND=bing,yandex

# ==================== 运行时性能开关 ====================
# 权限审查事实缓存 TTL（秒）；<=0 时禁用缓存
PERMISSION_PROFILE_CACHE_TTL_SECONDS=300
PERMISSION_REGION_CACHE_TTL_SECONDS=3600
# 最终输出清洗默认走确定性规则；仅在检测到明显残留时才用 LLM 兜底
FINAL_OUTPUT_LLM_CLEANUP_FALLBACK=false
