# Copy this file to .env and fill in real values for local development.
# Keep this file in git; do not put real secrets here.

# ==================== Server ====================
HOST_PORT=8125

# ==================== 登录系统 (Session 签名密钥) ====================
# 仅识别并拒绝旧 HMAC 会话；正式登录由独立 Java IAM 负责，不再签发本地登录票据。
AUTH_SECRET=<random-long-string>

# ==================== 后端 langgraph-api 地址 ====================
# 供代理/工具链确认后端位置 (前端直连配置在 frontend/.env.local 的 LANGGRAPH_API_URL)
LANGGRAPH_API_URL=http://localhost:2024

# ==================== SQLite Checkpointer (本地文件) ====================
# 单文件数据库,相对项目根,父目录会自动创建
SQLITE_PATH=db/checkpoints.db

# ==================== MCP 连接（平台部署配置）====================
# 旧 MCP_SERVER_URL/MCP_SERVER_NAME 仅保留兼容属性，不再是授权/发现来源。
# 连接只从 AGENT_MCP_CONNECTIONS_JSON（单行 JSON，推荐）或
# AGENT_MCP_CONNECTIONS_FILE（受保护文件）读取；浏览器不能指定地址/凭据。
# 每个启用连接必须显式登记已审核查询工具；未登记的新工具不会自动开放。
AGENT_MCP_CONNECTIONS_JSON={"schema_version":"agent.mcp-connections.v1","revision":1,"servers":[{"server_key":"ipp","url":"https://example.invalid/mcp","scope":"shared_readonly","auth_mode":"none","enabled":true,"approved_query_tools":["example_query_tool"]}]}
# AGENT_MCP_CONNECTIONS_FILE=/absolute/path/to/agent-mcp-connections.json

# LangSmith 库由框架依赖引入；关闭追踪，宿主 .env 不配置其 API key。
# licensed 原生服务的启动授权单独放在 .env.langgraph，见 README。
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGCHAIN_TRACING=false

# ==================== Langfuse 本地追踪 ====================
# Langfuse v4 为唯一保留的观测栈；统一启动器不重建该栈，按需单独启用。
# 公钥/私钥应与 .env.langfuse 中 LANGFUSE_INIT_PROJECT_* 对应。
# BASE_URL 走宿主机桥地址端口映射（langfuse-web 的 3001），避免跨容器服务名 DNS 不可靠。
LANGFUSE_ENABLED=true
# 启用后完整采集 SDK 可见的图/模型/工具输入输出、元数据和异常正文。
# 旧版统一正文过滤已按用户要求移除；普通业务台账与本地日志规则独立。
LANGFUSE_BASE_URL=http://192.168.64.1:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 提示词管理（试点，默认关闭）：开启后业务图会尝试从 Langfuse 拉取
# air-agent/<graph>/base-system；远程不存在或不可达时自动回落代码内默认值，
# 因此开启本身不影响可用性。SDK 缓存 TTL 默认 60s，热切换最多滞后一个 TTL。
LANGFUSE_PROMPTS_ENABLED=false

# ==================== SiliconFlow (公网 Embedding)====================
SILICONFLOW_API_KEY=<siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ==================== 主 LLM (本机 workbuddy2api 网关)====================
# OpenAI 兼容 /v1/chat/completions. hy3 为推理模型, max_tokens 需包含思考预算.
# 以下 192.168.64.1 仅为网桥地址示例；实际地址可能变化，须核实容器默认网关。
# 宿主网关仅需127.0.0.1:7863；容器通过受限19110桥访问，无需公开网关。
MAIN_LLM_API_KEY=<main-llm-api-key>
MAIN_LLM_BASE_URL=http://127.0.0.1:7863/v1
MAIN_LLM_MODEL=hy3

# ==================== Serper (联网搜索)====================
SERPER_API_KEY=<serper-api-key>

# ==================== DuckDuckGo (备用)====================
DDGS_PROXY=
DDGS_REGION=cn-zh
DDGS_TIMEOUT=15
DDGS_BACKEND=bing,yandex

# ==================== 模型上下文与工具治理 ====================
# 主模型官方上下文窗口 (Tokens, HY3 默认为 192K)
MODEL_MAX_CONTEXT_TOKENS=192000
# 用户单次输入最大字符数限制
MAX_INPUT_CHARS=8000
# 单次工具输出触发 Subagent 总结与专属落库的字符阈值
TOOL_OUTPUT_SUMMARY_THRESHOLD_CHARS=20000
# 多轮对话发送给模型的安全上下文 Token 预算
MODEL_CONTEXT_BUDGET_TOKENS=120000
# Subagent 总结提炼使用的独立模型 (留空则复用 MAIN_LLM_MODEL)
SUMMARY_LLM=
# 多轮长会话触发大模型滚雪球摘要压缩的 Token 阈值
CONVERSATION_SUMMARY_THRESHOLD_TOKENS=30000
# 会话摘要时保留最近不被压缩的活跃轮次数量
CONVERSATION_SUMMARY_KEEP_TURNS=3


# 完整请求预算（包含系统提示、工具定义、调用参数以及输出预留）
MAIN_LLM_MAX_OUTPUT_TOKENS=8192
MODEL_CONTEXT_SAFETY_TOKENS=4096
# 摘要模型名称沿用上方 SUMMARY_LLM；通道覆盖留空则复用主模型通道
SUMMARY_LLM_BASE_URL=
SUMMARY_LLM_API_KEY=
SUMMARY_MODEL_CONTEXT_TOKENS=192000
SUMMARY_MODEL_OUTPUT_TOKENS=4096
SUMMARY_MODEL_SAFETY_TOKENS=2048
SUMMARY_MAX_BATCHES=256
# 整理阶段与只读 QuickJS 执行资源；大载荷不可默默截断为局部统计
DATA_PROCESSING_TIMEOUT_SECONDS=90
QUICKJS_TIMEOUT_SECONDS=5
QUICKJS_MEMORY_MIB=64
QUICKJS_MAX_INPUT_BYTES=16777216
QUICKJS_MAX_RESULT_BYTES=131072
QUICKJS_MAX_CORRECTIONS=1
# 原始／派生资料保留期；0 明确关闭自动过期。聊天仍保留到手动删除会话
TOOL_ARTIFACT_RETENTION_DAYS=30
FINAL_OUTPUT_CLEANUP_TIMEOUT_SECONDS=45
# 仅精简模型看到的工具说明，不修改执行参数的验证规则
MODEL_TOOL_DESCRIPTION_CHARS=256
MODEL_TOOL_PARAMETER_DESCRIPTION_CHARS=120
# 工具定义目标占输入预算的比例；能精简时留出后续查询结果空间
MODEL_TOOL_SCHEMA_BUDGET_PERCENT=40
# 可选：实际模型对应的 tiktoken 编码名；留空按模型识别，未知别名用多语言估算
MODEL_TOKENIZER_ENCODING=
SUMMARY_TOKENIZER_ENCODING=
# 未知 tokenizer 估算余量（至少 1）；另保留上方模型安全 token 余量
MODEL_TOKEN_ESTIMATE_MARGIN=1.25

# ── 统一身份与企业化（add-tenant-identity-access）──
# admin API 运行角色连接（非 owner、非 BYPASSRLS；RLS 生效）。缺失则服务拒绝启动。
ADMIN_RUNTIME_DATABASE_URI=postgresql://air_agent_runtime:<random>@localhost:15432/air_agent_business
# langgraph-api 容器内的运行角色连接（写进 .env.langgraph，勿提交）
# RUNTIME_DATABASE_URI=postgresql://air_agent_runtime:<random>@postgres:5432/air_agent_business
# 企业角色密码（bootstrap_tenant_db.py 使用；不入 Git）
TENANT_RUNTIME_DB_PASSWORD=<random-long-string>
# 运行票据密钥（推荐 JSON 对象：kid → 密钥，首个条目用于签发；kid 与密钥内容绑定，
# 交错部署/重排/前插都不会使旧票据失效——R09。旧字符串数组形态按 v1..vN 索引编号，
# 仅作过渡兼容，重排会使旧票据失效。）
RUNTIME_TICKET_KEYS={"current":"<random-current-key>","previous":"<random-previous-key>"}
RUNTIME_TICKET_AUDIENCE=langgraph-runtime
# Next 服务端调用内部票据端点的凭据（浏览器不可见）
INTERNAL_API_TOKEN=<random-long-string>
# 归档 scope v2 签名密钥（Next 与 langgraph-api 共享同一数组）
ARCHIVE_SCOPE_KEYS=["<random-current-key>","<random-previous-key>"]
# 仅本地学习/开发环境允许默认 root/root 引导；生产必须用 ADMIN_BOOTSTRAP_* 显式授权
ALLOW_DEFAULT_ROOT_BOOTSTRAP=false
ADMIN_BOOTSTRAP_ACCOUNT=
ADMIN_BOOTSTRAP_PASSWORD=
# 已退役：旧 MCP 成员绑定与 server_key/协议门禁不再读取。

# ------------------------------------------------------------------ 事件台账
# （change add-agent-event-ledger）台账投递 worker 的**受限调度角色**连接：
# 非 BYPASSRLS、只有 outbox 租约列与事件非秘密列权限，用于跨租户领取任务。
# 未配置 = worker 未启用（不降级为运行角色跨租户领取）；本地/生产按需开启。
# LEDGER_WORKER_DATABASE_URI=postgresql://air_agent_ledger_worker:<random>@postgres:5432/air_agent_business
# 同上角色密码（bootstrap_tenant_db.py 可选创建；不入 Git）
TENANT_LEDGER_WORKER_DB_PASSWORD=<random-long-string>
TENANT_LEDGER_WORKER_ROLE=air_agent_ledger_worker
# 服务级只读校准凭据（reconcile/对账探针用；与用户成员会话完全独立，成员被撤销后仍可用）
# 未配置 = reconcile 校准如实报 blocked(missing_read_only_calibration_credential, rc=2)，
# 不得把 "no_platform_run_id 跳过" 当作校准闭合。
# LEDGER_RECONCILE_TICKET=<service-scoped-read-only-ticket>
# 历史归属只读报告使用的 owner 只读连接（可缺省，缺省回退 DATABASE_URI）
# LEDGER_REPORT_OWNER_URI=postgresql://air_agent:<random>@localhost:15432/air_agent_business
# 受控原问题快照保留期（天）。正常聊天提交按 request 保存一份用户原问题快照，
# 供后续热门问题分析按 request 精确回读；正文不进入普通事件/指标，到期或被删除即拒读。
LEDGER_CONTENT_RETENTION_DAYS=90
# 服务端租户覆盖；键为真实tenant UUID，普通请求只能缩短，不能延长这个上限。
# LEDGER_CONTENT_RETENTION_DAYS_BY_TENANT='{"00000000-0000-0000-0000-000000000001":7}'
# 状态投影网关固定本地回环原生API，服务票据不能直接读原生正文/历史。
# LEDGER_NATIVE_LOOPBACK_URL=http://127.0.0.1:8000
# 服务级只读校准密钥（与 RUNTIME_TICKET_KEYS 分离，独立轮换）。未配置=不签发 rs-v1 票据，
# reconcile 如实报 blocked 而非降级复用用户会话。
LEDGER_RECONCILE_KEYS='{"rk1":"<random-long-string>"}'
LEDGER_RECONCILE_AUDIENCE=ledger-reconcile
# 契约目录（默认 docs/contracts/agent-events-v1；仅路径，非秘密）
AGENT_EVENTS_CONTRACT_DIR=docs/contracts/agent-events-v1

# Change 3/5：先完成业务库迁移，再显式启用；启用时间使用含时区ISO8601。
AGENT_INTERACTIONS_ENABLED=false
AGENT_INTERACTIONS_ENABLED_AT=
AGENT_OBSERVABILITY_ENABLED=false
AGENT_OBSERVABILITY_MAX_QUEUE=1000
AGENT_OBSERVABILITY_MAX_BATCH=100
AGENT_OBSERVABILITY_FLUSH_WAIT_SECONDS=2
AGENT_OBSERVABILITY_MAX_RETRIES=3
# semantic-router间接依赖只读随包价格表，避免图导入时请求远端；不用于实际计费。
LITELLM_LOCAL_MODEL_COST_MAP=true
# 非秘密项目标签；必须与服务端Langfuse凭据所属项目一致，浏览器不接收密钥。
LANGFUSE_PROJECT_SCOPE=
# Change 4：能力与工具选择（默认关闭，先迁移部署后再显式启用）
AGENT_CAPABILITY_SELECTION_ENABLED=false
OTEL_BSP_MAX_QUEUE_SIZE=1000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=100

# Canonical post-I4 deployment. Copy credentials only into ignored local files.
DATABASE_URI=postgresql://air_agent:<owner-password>@127.0.0.1:15432/air_agent_business
RUNTIME_DATABASE_URI=postgresql://air_agent_runtime:<runtime-password>@127.0.0.1:15432/air_agent_business
AGENT_IDENTITY_BACKEND=remote
IAM_BASE_URL=http://127.0.0.1:19100
IAM_ADMIN_URL=http://127.0.0.1:19101
IAM_ISSUER=air-agent-iam
IAM_INTERNAL_CLIENT_ID=
IAM_INTERNAL_CLIENT_SECRET=
# Shared knowledge retrieval (deployment-fixed; never accepted from model/browser).
# Native container uses the private bridge path: http://192.168.64.1:19110/rag
KNOWLEDGE_API_URL=http://127.0.0.1:8099
KNOWLEDGE_DEADLINE_SECONDS=20
IAM_SSO_CLIENT_ID=
IAM_SSO_CLIENT_SECRET=
IAM_SSO_CLIENT_CALLBACK=http://127.0.0.1:3000/api/auth/iam/callback
IAM_SSO_ADMIN_CLIENT_ID=
IAM_SSO_ADMIN_CLIENT_SECRET=
IAM_SSO_ADMIN_CLIENT_CALLBACK=http://127.0.0.1:3100/api/auth/iam/callback
