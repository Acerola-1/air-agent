# Copy this file to .env and fill in real values for local development.
# Keep this file in git; do not put real secrets here.

# ==================== Server ====================
HOST_PORT=8125

# ==================== Chainlit UI (多图切换聊天界面) ====================
# chainlit_app.py 连接的 langgraph-api 地址, 本地 langgraph dev 默认 2024
LANGGRAPH_API_URL=http://localhost:2024

# ==================== SQLite Checkpointer (本地文件) ====================
# 单文件数据库,相对项目根,父目录会自动创建
SQLITE_PATH=db/checkpoints.db

# ==================== MCP Servers (凭据必需)====================
# 主业务数据源(MCP). 走内网地址, 如不可达请改成本地或自建服务
MCP_SERVER_URL=http://localhost:8090/product/ipp/api/mcp

# ==================== LangSmith 追踪 ====================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=app-final-test
LANGCHAIN_API_KEY=<langsmith-api-key>

# ==================== SiliconFlow (公网 Embedding)====================
SILICONFLOW_API_KEY=<siliconflow-api-key>
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# ==================== OpenCode Go DeepSeek V4 Flash (主 LLM)====================
# 走 OpenAI 兼容通道. 替代原本的 Ollama 本地模型
OPENCODE_GO_DEEPSEEK_V4_FLASH_API_KEY=<opencode-go-deepseek-v4-flash-api-key>
OPENCODE_GO_DEEPSEEK_V4_FLASH_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash

# ==================== Serper (联网搜索)====================
SERPER_API_KEY=<serper-api-key>

# ==================== DuckDuckGo (备用)====================
DDGS_PROXY=
DDGS_REGION=cn-zh
DDGS_TIMEOUT=15
DDGS_BACKEND=bing,yandex
