{
  "schema_version": "model-capacity-plan.v2",
  "run_id": "example-capacity-deepseek",
  "objective": "exploration",
  "budgets": {
    "max_seconds": 600,
    "max_requests": 100,
    "max_tokens": 800000
  },
  "retention": "retain_for_review",
  "allow_real_models": false,
  "allow_load": false,
  "stages": [
    {
      "stage_id": "u-exploration-c2",
      "layer": "U",
      "profile": "S",
      "phase": "explore",
      "model": "cn:deepseek-v4.1-flash",
      "arrival": "closed",
      "concurrency": 2,
      "duration_seconds": 300,
      "min_samples": 12,
      "request_deadline_seconds": 60,
      "token_ceiling_per_request": 8000,
      "gateway": {
        "base_url": "http://127.0.0.1:28763/v1",
        "api_key_env": "PERF_MODEL_KEY"
      },
      "workloads": [
        {
          "workload_id": "short-text",
          "messages": [
            {
              "role": "user",
              "content": "解释同比与环比的区别，不编造观测数值。"
            }
          ],
          "max_tokens": 256
        }
      ],
      "thresholds": {
        "first_answer_p95_ms": 5000,
        "complete_p95_ms": 30000,
        "min_success_rate": 0.99,
        "min_quality_rate": 0.99
      }
    }
  ]
}
