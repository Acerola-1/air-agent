    "/agent/reconcile/ticket": {
      "post": {
        "description": "F05：签发**服务主体**的窄范围只读校准凭据（rs-v1）.\n\n与用户会话票据完全分离的密钥与受众：原成员被撤销后，运维校准仍可按租户只读运行状态，\n但该凭据不能用于创建运行、读取消息或任何业务写入。租户必须真实存在且可用。\n\n凭据门槛是**部署内部令牌**（与其它内部端点同级），不要求任何用户会话——否则\n\"原成员被撤销后仍可校准\"这一目标就无法成立。",
        "operationId": "issue_reconcile_ticket_agent_reconcile_ticket_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReconcileTicketIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconcileTicketOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "签发服务级只读校准票据（内部）"
      }
    },
