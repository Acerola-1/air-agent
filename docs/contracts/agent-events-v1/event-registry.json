    "server_overrides_client": [
      "schema_version",
      "source",
      "tenant_id",
      "user_id",
      "membership_id",
      "received_at"
    ],
    "forbidden_payload_key_patterns": [
      "password",
      "password_hash",
      "passwd",
      "token",
      "ticket",
      "credential",
      "secret",
      "authorization",
      "cookie",
      "api_key",
      "apikey",
      "private_key"
    ],
    "limits": {
      "single_event_bytes": 16384,
      "browser_batch_events": 50,
      "browser_batch_bytes": 262144,
      "server_single_event_bytes": 65536
    }
  },
