# Local Langfuse v4 self-hosted stack credentials.
# Keep the real copy as .env.langfuse (gitignored). Generate secrets with:
#   openssl rand -hex 32
# The application API keys in .env must match LANGFUSE_INIT_PROJECT_* below.
#
# 内部地址一律写固定网络网关 10.99.0.1 的已发布端口，不要写 langfuse-postgres
# 这类服务名：Apple container 的服务名 DNS 会被宿主机 TUN 代理污染（任何名字都
# 解析成 fake-ip）。该栈固定在 air-agent-langfuse 网络（10.99.0.0/24），网关恒为
# 10.99.0.1；网络由 run_separated_local.py up 创建。

POSTGRES_USER=langfuse
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=langfuse
PGDATA=/var/lib/postgresql/data/pgdata
DATABASE_URL=postgresql://langfuse:<db-password>@10.99.0.1:15433/langfuse
SALT=<random-secret>
ENCRYPTION_KEY=<64-character-hex-secret>
NEXTAUTH_SECRET=<random-secret>
NEXTAUTH_URL=http://localhost:3001
TELEMETRY_ENABLED=false
LANGFUSE_ENABLE_EXPERIMENTAL_FEATURES=false

LANGFUSE_INIT_ORG_ID=air-agent
LANGFUSE_INIT_ORG_NAME=AirAgent
LANGFUSE_INIT_PROJECT_ID=air-agent
LANGFUSE_INIT_PROJECT_NAME=AirAgent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<public-key>
LANGFUSE_INIT_PROJECT_SECRET_KEY=<secret-key>
LANGFUSE_INIT_USER_EMAIL=admin@air-agent.local
LANGFUSE_INIT_USER_NAME=AirAgent
LANGFUSE_INIT_USER_PASSWORD=<random-password>

CLICKHOUSE_DB=default
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=<random-secret>
CLICKHOUSE_MIGRATION_URL=clickhouse://10.99.0.1:18124
CLICKHOUSE_URL=http://10.99.0.1:18123
CLICKHOUSE_CLUSTER_ENABLED=false
CLICKHOUSE_CLUSTER_NAME=default

REDIS_HOST=10.99.0.1
REDIS_PORT=16380
REDIS_AUTH=<random-secret>
REDIS_TLS_ENABLED=false
LANGFUSE_BULLMQ_SKIP_REDIS_VERSION_CHECK=false

MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=<random-secret>
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_REGION=auto
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<same-as-minio-root-password>
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=http://10.99.0.1:19000
LANGFUSE_S3_EVENT_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_EVENT_UPLOAD_PREFIX=events/
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_REGION=auto
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<same-as-minio-root-password>
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://10.99.0.1:19000
LANGFUSE_S3_MEDIA_UPLOAD_INTERNAL_ENDPOINT=http://10.99.0.1:19000
LANGFUSE_S3_MEDIA_UPLOAD_FORCE_PATH_STYLE=true
LANGFUSE_S3_MEDIA_UPLOAD_PREFIX=media/
