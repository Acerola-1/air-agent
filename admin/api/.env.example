# 单独部署本服务时才需要这份文件；本地开发会直接读仓库根目录的 .env
# 复制为 .env 后按需修改

# 平台共用的 PostgreSQL。宿主机上是 localhost:15432，compose 网络内是 postgres:5432。
# 不要加 +psycopg 前缀（服务内部自动转换；容器里的 Go core-server 只认裸 postgresql://）
DATABASE_URI=postgresql://air_agent:air_agent_dev@localhost:15432/air_agent

# session token 签名密钥。必须与 frontend/.env.local 完全一致，
# 否则前端 middleware 验不过签发的 cookie。
AUTH_SECRET=<random-long-string>

HOST=0.0.0.0
PORT=8100

# 本地 http 必须 false；生产 https 置 true
COOKIE_SECURE=false

# JSON 数组格式
CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]

# scripts/seed.py 创建的初始管理员（对外部署前请改掉）
ROOT_ACCOUNT=root
ROOT_PASSWORD=root
ROOT_DISPLAY_NAME=超级管理员

# Change 3/5：先完成业务库迁移，再显式启用；启用时间使用含时区ISO8601。
AGENT_INTERACTIONS_ENABLED=false
AGENT_INTERACTIONS_ENABLED_AT=
AGENT_OBSERVABILITY_ENABLED=false
AGENT_OBSERVABILITY_MAX_QUEUE=1000
AGENT_OBSERVABILITY_MAX_BATCH=100
AGENT_OBSERVABILITY_FLUSH_WAIT_SECONDS=2
AGENT_OBSERVABILITY_MAX_RETRIES=3
# 非秘密项目标签；必须与服务端Langfuse凭据所属项目一致，浏览器不接收密钥。
LANGFUSE_PROJECT_SCOPE=
OTEL_BSP_MAX_QUEUE_SIZE=1000
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=100
